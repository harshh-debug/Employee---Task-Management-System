# Shared root environment template. Copy to .env and fill local values.
# Server loads root .env first, then server/.env for missing values.
# Vite reads only VITE_ variables from this file; server secrets stay server-side.
# Never commit .env or expose MongoDB values through a VITE_ variable.

# SERVER ONLY
NODE_ENV=development
PORT=5000
# Requires a replica set for transactions. For managed MongoDB, replace with
# its real connection string only in your ignored server env/host secret store.
MONGODB_URI=mongodb://127.0.0.1:27017/roots_employee_tasks?replicaSet=rs0
CLIENT_ORIGIN=http://localhost:5173
# Proposed UTC business-date convention. Validate/support this variable in code.
BUSINESS_TIMEZONE=UTC

# CLIENT PUBLIC BUILD-TIME CONFIGURATION (safe to expose)
VITE_API_BASE_URL=http://localhost:5000/api

# TEST SERVER ONLY: separate database on a transaction-capable replica set.
# Never point this at production; do not run destructive tests there.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/roots_employee_tasks_test?replicaSet=rs0
